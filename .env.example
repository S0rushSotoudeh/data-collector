# Copy this file to .env before running Docker Compose.
# Replace every CHANGE_ME value with a private value; .env is ignored by git.

# Runtime
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
APP_TIMEZONE=Asia/Tehran
API_BIND_HOST=0.0.0.0
API_CONTAINER_NAME=dc-api
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
RESTART_POLICY=unless-stopped
UID=1000
GID=1000

# Image/build versions
PYTHON_VERSION=3.13
APP_USER=appuser
PIP_PACKAGE=pip>=26.1
UV_PACKAGE=uv
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
REDIS_IMAGE=redis:latest
POSTGRES_IMAGE=postgres:latest
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:latest
DBGATE_IMAGE=dbgate/dbgate:latest

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_BIND_HOST=0.0.0.0
POSTGRES_USER=dc_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dc_metadata
POSTGRES_CONTAINER_NAME=dc-postgres

# ClickHouse (the Python client uses the HTTP interface)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_NATIVE_HOST_PORT=9000
CLICKHOUSE_BIND_HOST=0.0.0.0
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_CONNECT_TIMEOUT=10
CLICKHOUSE_CONNECT_RETRIES=3
CLICKHOUSE_RETRY_DELAY=1.0
CLICKHOUSE_CONTAINER_NAME=dc-clickhouse

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_BIND_HOST=0.0.0.0
REDIS_URL=redis://redis:6379/0
REDIS_CONTAINER_NAME=dc-redis
CELERY_WORKER_CONTAINER_NAME=dc-celery-worker
CELERY_BEAT_CONTAINER_NAME=dc-celery-beat
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=info
BEAT_FETCH_HOUR=1
BEAT_BOND_ORDER_BOOK_MINUTE=0
BEAT_BOND_TRADES_MINUTE=5
BEAT_OPTION_SYNC_MINUTE=10
BEAT_STOCK_SYNC_MINUTE=15
BEAT_OPTION_ORDER_BOOK_MINUTE=20
BEAT_OPTION_TRADES_MINUTE=25
BEAT_STOCK_ORDER_BOOK_MINUTE=30
BEAT_STOCK_TRADES_MINUTE=35
BEAT_MARKET_POTENTIAL_MINUTE=45
BEAT_IME_TRADES_MINUTE=40

# Flower
FLOWER_CONTAINER_NAME=dc-flower
FLOWER_BIND_HOST=127.0.0.1
FLOWER_HOST_PORT=5555
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:CHANGE_ME

# DbGate
DBGATE_CONTAINER_NAME=dc-dbgate
DBGATE_BIND_HOST=127.0.0.1
DBGATE_HOST_PORT=3090
DBGATE_PORT=3000

# Service health checks
HEALTHCHECK_HOST=127.0.0.1
HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_RETRIES=5

# External market-data services
TSETMC_CDN_BASE_URL=https://cdn.tsetmc.com/api
TSETMC_LEGACY_BASE_URL=https://old.tsetmc.com
TSETMC_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
TSETMC_CONCURRENCY=5
TSETMC_RETRIES=3
TSETMC_TIMEOUT=30.0
TSETMC_REQUEST_DELAY=0.5

# Iran Mercantile Exchange physical market
IME_BASE_URL=https://www.ime.co.ir
IME_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
IME_TIMEOUT=60.0
IME_RETRIES=3
IME_REQUEST_DELAY=0.5
IME_BACKFILL_CHUNK_DAYS=365
IME_RECENT_LOOKBACK_DAYS=7

# Optional provider credentials (leave empty unless the integration is enabled)
PARSIAN_WS_COOKIE=
