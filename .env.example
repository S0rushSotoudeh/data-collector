## PostgreSQL — use "postgres" inside Docker, "localhost" for native dev
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=dc_user
# POSTGRES_PASSWORD=dc_pass
# POSTGRES_DB=dc_metadata

## ClickHouse — use "clickhouse" inside Docker, "localhost" for native dev
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=clickhouse

## Redis — use "redis" inside Docker, "localhost" for native dev
# REDIS_HOST=redis
# REDIS_PORT=6379

## Admin Panel — override these in .env (not tracked by git)
# ADMIN_USER=admin
# ADMIN_PASSWORD=changeme
# SECRET_KEY=generate-a-random-secret-key-here